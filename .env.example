# Environment Variables for Audio Fetch

# CORS Configuration
# For development: use "*" to allow all origins
# For production: specify exact domains (comma-separated)
# Example: CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=*

# Port (used in Docker deployment)
# Render automatically sets this, but you can override locally
# PORT=8000

# YouTube Cookie Configuration (REQUIRED for downloads)
# Approach 1: Path to a Netscape format cookie file
# YOUTUBE_COOKIES_FILE=/path/to/cookies.txt

# Approach 2: Raw cookie string in Netscape format (wrap in quotes if multi-line)
# YOUTUBE_COOKIES="# Netscape HTTP Cookie File..."
