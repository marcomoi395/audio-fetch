# Environment Variables for Audio Fetch

# CORS Configuration
# For development: use "*" to allow all origins
# For production: specify exact domains (comma-separated)
# Example: CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=*

# Port (used in Docker deployment)
# Render automatically sets this, but you can override locally
# PORT=8000

# YouTube Authentication
# Cookies are now provided through the web interface when needed.
# No environment configuration required for cookie authentication.
